{
  "name": "lianjia-order-api",
  "version": "1.0.0",
  "private": true,
  "description": "链家烧烤微信云托管独立后端：登录、同桌点餐、自取、接单与收银",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.js",
    "db:check-restore": "node scripts/check-restore.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/test-integration.js"
  },
  "dependencies": { "mysql2": "3.24.5" },
  "engines": { "node": ">=22.9.0" }
}
