# Copy to .env for local development. Supply real values in deployment settings.
PORT=8080
WX_APPID=
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=food_ordering
MYSQL_PASSWORD=
MYSQL_DATABASE=food_ordering
# Comma-separated account identifiers returned by /api/login, not passwords.
OWNER_USER_IDS=
CASHIER_USER_IDS=
# Optional compatibility with older installations; normally leave empty.
CASHIER_OPENIDS=
